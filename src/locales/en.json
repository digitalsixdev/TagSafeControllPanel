            "aboutContainer": {
                "title": "TagSafe Control Panel",
                "subtitle": "Centralized management platform for master administrators of the TagSafe ecosystem.",

                "explication": {
                    "about": {
                        "title": "WHAT IT'S FOR",
                        "text": "This panel allows <role/> users to manage the entire platform structure: from registering companies and their units to controlling users, roles, and links to available modules."
                    },
                    "howToAccess": {
                        "title": "HOW TO ACCESS",
                        "firstStep": "Log in with an account with the Master role.",
                        "secondStep": "Use the side menu to navigate between panels",
                        "thirdStep": "Manage companies, units, and users independently."
                    }
                }
            },

            "panelsContainer": {
                "title": "Available panels",
                "subtitle": "The control panel is divided into two main sections, accessible from the side menu.",

                "companiesCard": {
                    "title": "Companies Panel",
                    "subtitle": "Manage all companies and their units registered on the platform.",

                    "features": {
                        "first": "Register new companies with CNPJ and modules",
                        "second": "Add and edit units per company",
                        "third": "Link modules (TR, GL) to each unit",
                        "fourty": "Search companies by name or CNPJ",
                        "fifth": "View users linked to each unit",
                        "sixth": "Edit company and unit data"
                    }
                },

                "usersCard": {
                    "title": "Users Panel",
                    "subtitle": "Full control over users, roles, links, and instructors.",

                    "features": {
                        "first": "Register users with role and linked unit",
                        "second": "Register instructors with attended units and modules",
                        "third": "Link existing instructors to new units",
                        "fourty": "Link users to additional units",
                        "fifth": "Edit name and roles of any user",
                        "sixth": "Filter users by name, e-mail, company, or role"
                    }
                }
            },

            "rolesContainer": {
                "title": "Platform roles",
                "subtitle": "Each user has a role that defines their access level within the system.",

                "roles": {
                    "default": {
                        "name": "Default",
                        "about": "Basic platform access"
                    },

                    "admin": {
                        "name": "Admin",
                        "about": "Administrative permissions"
                    },

                    "instructor": {
                        "name": "Instructor",
                        "about": "Access to attended units"
                    },

                    "master": {
                        "name": "Master",
                        "about": "Full access to the control panel"
                    }
                }
            },

            "modulesContainer": {
                "title": "Available modules",
                "subtitle": "Modules define which features are active in each registered unit.",

                "tr": {
                    "name": "Training Safe",
                    "prefix": "TR",
                    "about": "Module focused on the management and control of safety training sessions carried out in units."
                },

                "gl": {
                    "name": "GL Safe",
                    "prefix": "GL",
                    "about": "Module focused on the management and control of workplace gymnastics sessions carried out in units."
                }
            }
        }
